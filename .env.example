cat > .env.example << 'EOF'
# ============================================================================
# QuantDSS India — Environment Variables Template
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (exact same folder)
# 2. Fill in your API keys below
# 3. NEVER commit .env to GitHub (it's in .gitignore)
# 4. Keep this .env.example file in GitHub as documentation
#

# ============================================================================
# GEMINI API (Google Generative AI)
# ============================================================================
# Get your free key from: https://ai.google.dev
# Free tier: 15 requests/min, 1500 requests/day, gemini-2.5-flash model
# IMPORTANT: This is for AI-generated investment summaries and insights
#
GEMINI_API_KEY=AIza_YOUR_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# ALPHA VANTAGE API (Optional — for live quote enrichment)
# ============================================================================
# Get your free key from: https://www.alphavantage.co/support/#api-key
# Free tier: 5 requests/min, 500 requests/day
# IMPORTANT: Indian market coverage is limited; yfinance is primary
#
ALPHA_VANTAGE_API_KEY=PK_YOUR_KEY_HERE

# ============================================================================
# RECOMMENDER PROVIDER (Which service to use for recommendations)
# ============================================================================
# Options: "gemini" (default), "alpha_vantage", "static"
# 
# "gemini"        → AI-written summaries + live data (requires GEMINI_API_KEY)
# "alpha_vantage" → Computed text + live quotes (requires ALPHA_VANTAGE_API_KEY)
# "static"        → Pure computed recommendations (no API keys needed)
#
RECOMMENDER_PROVIDER=gemini

# ============================================================================
# EXAMPLES OF WHAT WILL WORK
# ============================================================================
# Scenario 1: Maximum features (AI summaries + live quotes)
#   GEMINI_API_KEY=AIza_xxx
#   ALPHA_VANTAGE_API_KEY=PK_xxx
#   RECOMMENDER_PROVIDER=gemini
#   → You get AI text + live NSE prices
#
# Scenario 2: AI but no live quotes
#   GEMINI_API_KEY=AIza_xxx
#   # Leave ALPHA_VANTAGE_API_KEY commented/empty
#   RECOMMENDER_PROVIDER=gemini
#   → You get AI text, prices from yfinance only
#
# Scenario 3: No APIs (pure ML + data-driven text)
#   # Leave both commented/empty
#   RECOMMENDER_PROVIDER=static
#   → No API keys needed, everything runs locally
#
# Scenario 4: Testing / development
#   # Same as Scenario 3
#   → Run the app without any API calls for testing
#

# ============================================================================
# OPTIONAL: Logging (for debugging)
# ============================================================================
# LOG_LEVEL=INFO
# LOG_FILE=logs/quantdss.log
EOF